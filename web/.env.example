# Copy to web/.env.local and fill in. NEVER commit web/.env.local.

# Network selection
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_GALILEO_CHAIN_ID=16602

# Privy (https://dashboard.privy.io)
NEXT_PUBLIC_PRIVY_APP_ID=

# Contract addresses (set after running forge deploy)
NEXT_PUBLIC_AGENT_NFT_ADDRESS=
NEXT_PUBLIC_KILN_MARKET_ADDRESS=
NEXT_PUBLIC_VERIFIER_ADDRESS=

# Server-side only (NEVER prefix with NEXT_PUBLIC_)
KILN_OPS_PK=
KILN_OPS_ADDRESS=
ZG_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
ZG_RPC_URL=https://evmrpc-testnet.0g.ai
